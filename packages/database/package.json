{
  "name": "@books/database",
  "version": "1.0.0",
  "private": true,
  "license": "Beerware",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "clean:dist": "rimraf dist",
    "db:check": "drizzle-kit check",
    "db:erd": "tsx ./src/scripts/erd.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local ./src/scripts/reset.ts",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local ./src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "vite build --watch",
    "start": "vite build",
    "test": "vitest run",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "drizzle-seed": "0.3.1",
    "pg": "8.23.1",
    "postgres": "4.0.0"
  },
  "devDependencies": {
    "@books/typescript-config": "workspace:*",
    "@dotenvx/dotenvx": "2.38.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
