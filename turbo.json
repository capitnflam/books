{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["DATABASE_URL", "VITE_CLERK_PUBLISHABLE_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "clean:dist": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "type:check": {
      "dependsOn": ["^build"]
    },
    "//#lint:check": {
      "dependsOn": ["^build"]
    },
    "//#lint:fix": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#format:check": {
      "cache": false
    },
    "//#format:fix": {
      "cache": false
    },
    "test": {},
    "db:generate": {
      "cache": false,
      "persistent": true
    },
    "db:check": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "persistent": true
    },
    "db:pull": {
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "cache": false,
      "persistent": true
    },
    "db:reset": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
