{
  "name": "webapp",
  "private": true,
  "license": "Beerware",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "clean:dist": "rimraf dist",
    "dev": "vite dev --port 3000",
    "generate-routes": "node scripts/generate-routes.ts",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --emit-ts-declarations --silent",
    "postinstall": "pnpm paraglide:compile",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "type:check": "pnpm paraglide:compile && tsc --noEmit"
  },
  "dependencies": {
    "@books/database": "workspace:*",
    "@books/ui": "workspace:*",
    "@clerk/tanstack-react-start": "1.7.8",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@books/typescript-config": "workspace:*",
    "@inlang/paraglide-js": "2.29.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
